<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Guades_QCUCram_Site.Master.cs" Inherits="Guades_QCUCram.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - QCU-CRAM</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <%-- Bootstrap comes from the bundle, then the site stylesheet. AssetUrl() adds the file's last-saved
         time to the address, so a changed file is never served from the browser's old cache. --%>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <asp:PlaceHolder runat="server">
        <link href="<%= AssetUrl("~/Content/Site.css") %>" rel="stylesheet" />
    </asp:PlaceHolder>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <%-- QCU seal as the browser-tab icon (?v=2 busts the browser cache) --%>
    <link href="~/favicon.ico?v=2" rel="shortcut icon" type="image/x-icon" />
    <link href="~/Content/images/favicon-16.png?v=2" rel="icon" type="image/png" sizes="16x16" />
    <link href="~/Content/images/favicon-32.png?v=2" rel="icon" type="image/png" sizes="32x32" />
    <link href="~/Content/images/favicon-192.png?v=2" rel="icon" type="image/png" sizes="192x192" />
    <link href="~/Content/images/apple-touch-icon.png?v=2" rel="apple-touch-icon" sizes="180x180" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <header class="qcu-header">
            <div class="qcu-header-inner">
                <a runat="server" href="~/"><img src="<%= ResolveUrl("~/Content/images/qcu-logo.png") %>" alt="QCU Seal" /></a>
                <div>
                    <a runat="server" href="~/" class="qcu-brand-name">Quezon City University</a>
                    <div class="qcu-brand-sub">QCU-CRAM &middot; Collaboration Room Access and Monitoring</div>
                </div>
            </div>
        </header>
        <nav class="navbar navbar-expand-lg navbar-dark qcu-nav<%= NavExtraClass %>"<%= NavExtraAttr %>>
            <div class="container">
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNav" title="Toggle navigation" aria-controls="mainNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">

                    <%-- LEFT: page links --%>
                    <ul class="navbar-nav me-auto">

                        <%-- Logged out --%>
                        <asp:PlaceHolder ID="phGuest" runat="server">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Account/Guades_QCUCram_Login.aspx">Login</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Account/Guades_QCUCram_Register.aspx">Register</a></li>
                        </asp:PlaceHolder>

                        <%-- Student / Faculty / Visitor --%>
                        <asp:PlaceHolder ID="phStudent" runat="server">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Student/Guades_QCUCram_Dashboard.aspx">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Availability.aspx">Availability</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Student/Guades_QCUCram_Reserve.aspx">Reserve</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Student/Guades_QCUCram_MyReservations.aspx">My Reservations</a></li>
                        </asp:PlaceHolder>

                        <%-- Library Assistant --%>
                        <asp:PlaceHolder ID="phAdmin" runat="server">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_Dashboard.aspx">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Availability.aspx">Availability</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_Queue.aspx">Review Queue</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_CheckIn.aspx">Check-In</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_Records.aspx">Records</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_Restrictions.aspx">Restrictions</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Reports/Guades_QCUCram_Analytics.aspx">Reports</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Guades_QCUCram_Reports/Guades_QCUCram_DailySchedule.aspx">Daily Schedule</a></li>
                        </asp:PlaceHolder>

                    </ul>

                    <%-- RIGHT: account area. Same layout for both roles: [tools] | Logged in as ... | logout icon --%>
                    <ul class="navbar-nav qcu-nav-right">

                        <%-- Student side: Notifications (bell) + Profile (Change Password lives inside Profile) --%>
                        <asp:PlaceHolder ID="phStudentRight" runat="server">
                            <li class="nav-item">
                                <a class="nav-link qcu-nav-icon" runat="server" href="~/Guades_QCUCram_Student/Guades_QCUCram_Notifications.aspx" title="Notifications" aria-label="Notifications">
                                    <svg class="qcu-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="qcu-nav-label">Notifications</span><asp:Literal ID="litUnread" runat="server"></asp:Literal>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" runat="server" href="~/Guades_QCUCram_Student/Guades_QCUCram_Profile.aspx" data-qcu-also="changepassword"><svg class="qcu-ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Profile</span></a>
                            </li>
                        </asp:PlaceHolder>

                        <%-- Admin side: Maintenance (with Change Password inside) --%>
                        <asp:PlaceHolder ID="phAdminRight" runat="server">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><svg class="qcu-ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span>Maintenance</span></a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_Rooms.aspx">Rooms</a></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_TimeSlots.aspx">Time Slots</a></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_Students.aspx">Students</a></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_AdminUsers.aspx">Admin Accounts</a></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_Settings.aspx">Settings</a></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Guades_QCUCram_Admin/Guades_QCUCram_DevTools.aspx">Dev Tools</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Guades_QCUCram_Account/Guades_QCUCram_ChangePassword.aspx"
                                        onclick="return qcuConfirm(this, { tone: 'primary', title: 'Change your password?', message: 'You will be taken to the Change Password page.', confirmText: 'Continue' });">Change Password</a></li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>

                        <%-- Both roles: who is logged in + logout icon --%>
                        <asp:PlaceHolder ID="phUser" runat="server">
                            <li class="nav-item qcu-nav-user">
                                <span class="navbar-text">Logged in as <asp:Literal ID="litUser" runat="server"></asp:Literal></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link qcu-nav-icon qcu-nav-logout" runat="server" href="~/Guades_QCUCram_Account/Guades_QCUCram_Logout.aspx" title="Log out" aria-label="Log out"
                                    onclick="return qcuConfirm(this, { tone: 'warning', title: 'Log out?', message: 'You will be signed out of QCU-CRAM.', confirmText: 'Log out' });"><svg class="qcu-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg><span class="qcu-nav-label">Log out</span></a>
                            </li>
                        </asp:PlaceHolder>

                    </ul>
                </div>
            </div>
        </nav>
                <asp:PlaceHolder ID="phDevClock" runat="server" Visible="false">
            <div class="alert alert-danger text-center rounded-0 mb-0">
                <strong>Dev clock active:</strong> <asp:Literal ID="litDevClock" runat="server"></asp:Literal>
            </div>
        </asp:PlaceHolder>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <%-- Footer: always at the bottom of the window (the page is a flex column; the footer has margin-top:auto) --%>
        <div class="qcu-site-footer">
            <footer class="qcu-footer">
                <div class="qcu-footer-inner">
                    <div class="qcu-footer-brand">
                        <img src="<%= ResolveUrl("~/Content/images/qcu-logo.png") %>" alt="QCU Seal" />
                        <div>
                            <div class="qcu-footer-title">Quezon City University</div>
                            <div class="qcu-footer-sys">QCU-CRAM &middot; Collaboration Room Access and Monitoring</div>
                        </div>
                    </div>
                    <div class="qcu-footer-col">
                        <div class="qcu-footer-head">Contact</div>
                        <div class="qcu-footer-line">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            <span>673 Quirino Highway, San Bartolome, Novaliches, Quezon City</span>
                        </div>
                        <div class="qcu-footer-line">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                            <span>(02) 8806-3049</span>
                        </div>
                    </div>
                    <div class="qcu-footer-col">
                        <div class="qcu-footer-head">Quick links</div>
                        <%= FooterLinks %>
                    </div>
                </div>
            </footer>
            <div class="qcu-footer-bar">&copy; <%: DateTime.Now.Year %> QCU-CRAM: QCU Collaboration Room Access and Monitoring</div>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.bundle.js") %>
    </asp:PlaceHolder>
    <%-- Shared: password eye, dashed student numbers, strength meter --%>
    <script src="<%= AssetUrl("~/Scripts/qcu-site.js") %>"></script>
    <%-- Shared: confirmation modals, live search/filters, Add / Edit pop-ups --%>
    <script src="<%= AssetUrl("~/Scripts/qcu-ui.js") %>"></script>
    <script>
        // Highlight the current page in the nav (orange, like "Home" on qcu.edu.ph)
        (function () {
            var path = location.pathname.toLowerCase();
            document.querySelectorAll('.qcu-nav a.nav-link, .qcu-nav a.dropdown-item').forEach(function (a) {
                var p = a.getAttribute('href');
                var also = (a.getAttribute('data-qcu-also') || '').toLowerCase();   // e.g. Profile is also "current" on Change Password
                var hit = p && p !== '#' && path.endsWith(p.split('/').pop().toLowerCase());
                if (!hit && also && path.indexOf(also) !== -1) hit = true;
                if (hit && !a.classList.contains('qcu-nav-logout')) {
                    a.classList.add('active');
                    var dd = a.closest('.dropdown');
                    if (dd) dd.querySelector('.dropdown-toggle').classList.add('active');
                }
            });
        })();
    </script>
</body>
</html>